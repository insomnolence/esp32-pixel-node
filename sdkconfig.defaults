# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# Flash size configuration
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# BLE UUIDs (Nordic UART Service compatible)
CONFIG_BLE_SERVICE_UUID="6e400001-b5a3-f393-e0a9-e50e24dcca9e"
CONFIG_BLE_CHARACTERISTIC_UUID="6e400002-b5a3-f393-e0a9-e50e24dcca9e"
CONFIG_BLE_HEALTH_SERVICE_UUID="12345678-1234-1234-1234-123456789abc"
CONFIG_BLE_HEALTH_CHARACTERISTIC_UUID="87654321-4321-4321-4321-cba987654321"