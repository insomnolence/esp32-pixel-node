# Test project defaults
# Enable Bluetooth for hardware testing
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y

# Disable WiFi - not needed for unit tests
CONFIG_ESP_WIFI_ENABLED=n

# Button Interface - uses defaults from components/system_control/Kconfig
CONFIG_BUTTON_INTERFACE_ENABLED=y
