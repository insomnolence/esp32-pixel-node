menu "Example 'Pixel ESP32' Config"

    config SET_RAW_ADV_DATA
        bool "Use raw data for advertising packets and scan response data"
        help
            If this config item is set, raw binary data will be used to generate advertising & scan response data.
            This option uses the esp_ble_gap_config_adv_data_raw() and esp_ble_gap_config_scan_rsp_data_raw()
            functions.

            If this config item is unset, advertising & scan response data is provided via a higher-level
            esp_ble_adv_data_t structure. The lower layer will generate the BLE packets. This option has higher
            overhead at runtime.

endmenu

menu "Button Interface Configuration"
    config BUTTON_INTERFACE_ENABLED
        bool "Enable Button Interface"
        default y if IDF_TARGET_ESP32C3
        default n
        help
            Enable dual-button interface for standalone LED control.
            ESP32C3 custom board has dedicated buttons on GPIO 2 and 3.
            Other platforms can enable and configure GPIO pins as needed.
            
    config BUTTON_1_GPIO
        int "Button 1 GPIO Pin"
        depends on BUTTON_INTERFACE_ENABLED
        range 0 48
        default 3 if IDF_TARGET_ESP32C3
        default 0
        help
            GPIO pin for Button 1 (sequence cycling: Idle → Warning → Exit → Idle).
            ESP32C3 custom board: GPIO 3
            
    config BUTTON_2_GPIO
        int "Button 2 GPIO Pin"
        depends on BUTTON_INTERFACE_ENABLED
        range 0 48
        default 2 if IDF_TARGET_ESP32C3
        default 1
        help
            GPIO pin for Button 2 (random preset selection).
            ESP32C3 custom board: GPIO 2
            
    config BUTTON_DEBOUNCE_MS
        int "Button Debounce Time (ms)"
        depends on BUTTON_INTERFACE_ENABLED
        range 10 500
        default 50
        help
            Debounce time for button presses to prevent false triggers.
endmenu
